<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F1E7"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <!-- Back button -->
    <TextView
        android:id="@+id/btnBackRecommended"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textColor="#183E33"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

    <!-- Page title -->
    <TextView
        android:id="@+id/textViewRecommendedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recommended Books"
        android:textColor="#183E33"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Section description -->
    <TextView
        android:id="@+id/textViewRecommendedSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Popular Classics"
        android:textColor="#BD964F"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <!-- Books from Firebase -->
    <ListView
        android:id="@+id/listViewRecommendedBooks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DDDDDD"
        android:dividerHeight="1dp" />

</LinearLayout>
