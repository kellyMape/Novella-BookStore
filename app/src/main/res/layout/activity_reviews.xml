<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp"
    android:background="#F5F1E7"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/btnBackReviews"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="‹"
            android:textSize="32sp"
            android:textColor="#183E33"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ratings &amp; Comments"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#183E33"
            android:gravity="center"
            android:layout_marginEnd="48dp" />
    </LinearLayout>

    <!-- Book title -->
    <TextView
        android:id="@+id/txtReviewBookTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Book Title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:textColor="#183E33"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!--  average -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#183E33"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:id="@+id/txtAverage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No reviews yet"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share your thoughts"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="#183E33"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your rating"
            android:textStyle="bold"
            android:textColor="#183E33" />

        <Spinner
            android:id="@+id/spinnerRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your comment"
            android:textStyle="bold"
            android:textColor="#183E33" />

        <EditText
            android:id="@+id/edtComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="What did you think of this book?"
            android:minLines="2" />

        <Button
            android:id="@+id/btnSubmitReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit review"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#183E33"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Reader comments -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reader comments"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:textColor="#183E33"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/listViewReviews"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp" />

</LinearLayout>