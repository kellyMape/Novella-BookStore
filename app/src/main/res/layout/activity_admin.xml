<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F1E7">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Dashboard"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:textColor="#183E33"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/btnManageBooks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Books"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#183E33"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnAddBook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Book"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#183E33"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOrders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Orders"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#183E33"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnUsers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Users"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#183E33"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/adminlogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log out"
        android:textAllCaps="false"
        android:textColor="#183E33"
        android:backgroundTint="#CFBA94" />

</LinearLayout>