<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    tools:context=".AddBookActivity"
    android:layout_margin="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADD A NEW BOOK"
            android:textSize="19dp"
            android:textStyle="bold"
            android:textColor="@color/green"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

<!--        cover -->
        <ImageView
            android:id="@+id/imgViewCover"
            android:layout_width="140dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:background="#E0E0E0"
            android:src="@android:drawable/ic_menu_gallery" />

        <Button
            android:id="@+id/btnSelectCover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="Select Cover"
            android:textColor="@color/green"
            android:backgroundTint="@color/white"/>
<!--information -->
        <EditText
            android:id="@+id/edtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Title"
            android:inputType="text"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/edtAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Author"
            android:inputType="text"
            android:layout_marginTop="12dp"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Genre"
            android:textStyle="bold"
            android:layout_marginTop="11dp"/>
        
        <Spinner
            android:id="@+id/spinnerGenre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        
        <EditText
            android:id="@+id/edtPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Price"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp"/>
        
        <EditText
            android:id="@+id/edtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"/>
        
        <CheckBox
            android:id="@+id/checkRecommend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show in Recommended"
            android:layout_marginTop="12dp"/>

        <CheckBox
            android:id="@+id/checkAvailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available for sale"
            android:checked="true" />

        <Button
            android:id="@+id/btnSaveBook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SAVE BOOK"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/green"
            android:paddingVertical="10dp"/>
    </LinearLayout>
</ScrollView>