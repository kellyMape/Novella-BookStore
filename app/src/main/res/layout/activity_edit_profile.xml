<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1E7"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Page title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="#183E33"
            android:layout_marginBottom="24dp"/>

        <!-- Personal Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personal Information"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="#183E33"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textColor="#183E33"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/editProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="First and last name"
            android:inputType="textPersonName"
            android:textColor="#183E33"
            android:textColorHint="#888888"
            android:backgroundTint="#183E33"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="#183E33"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/editProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textColor="#183E33"
            android:backgroundTint="#183E33"
            android:enabled="false"
            android:layout_marginBottom="28dp"/>

        <!-- Security -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Security"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="#183E33"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leave these fields empty if you do not want to change your password."
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="16dp"/>

        <!-- Current password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Password"
            android:textColor="#183E33"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/currentPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter current password"
            android:inputType="textPassword"
            android:textColor="#183E33"
            android:backgroundTint="#183E33"
            android:layout_marginBottom="16dp"/>

        <!-- New password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New Password"
            android:textColor="#183E33"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/newPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="At least 6 characters"
            android:inputType="textPassword"
            android:textColor="#183E33"
            android:backgroundTint="#183E33"
            android:layout_marginBottom="16dp"/>

        <!-- Confirm password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm New Password"
            android:textColor="#183E33"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/confirmNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirm new password"
            android:inputType="textPassword"
            android:textColor="#183E33"
            android:backgroundTint="#183E33"
            android:layout_marginBottom="30dp"/>

        <!-- Buttons -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#183E33"/>

        <Button
            android:id="@+id/btnCancelProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#183E33"
            android:backgroundTint="#F5F1E7"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
