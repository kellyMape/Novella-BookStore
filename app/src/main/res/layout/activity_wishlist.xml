<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F1E7"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <!-- Heather: back button + title (same as the order screens) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/btnBackWishlist"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="‹"
        android:textColor="#183E33"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Page title -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="My Wishlist ♡"
        android:textColor="#183E33"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginEnd="48dp" />

    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your saved books"
        android:textColor="#BD964F"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Empty wishlist message -->
    <TextView
        android:id="@+id/textViewEmptyWishlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No saved books yet."
        android:textColor="#183E33"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <!-- Saved books list -->
    <ListView
        android:id="@+id/listViewWishlist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#D8D0BE"
        android:dividerHeight="1dp" />

</LinearLayout>
